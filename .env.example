# Copia este archivo como .env y ajusta los valores a tu entorno.

# Puerto donde escucha la app
PUERTO=5000

# Nombre que aparece en el encabezado
NOMBRE_AREA=Explorador de Scripts

# Carpeta raiz sobre la que se arma todo el explorador.
# Usa ruta UNC (\\servidor\carpeta), no una letra de unidad de red,
# porque esa letra no existe cuando la app corre como tarea del sistema.
AREA=C:\ruta\a\tu\area

# Segundos maximos que se deja correr un .bat antes de matarlo
TIEMPO_MAXIMO=900

# "Abrir" (lanzar el archivo en el PC donde corre Flask) solo
# aparece para quien navega desde ese mismo equipo
PERMITIR_ABRIR_EN_SERVIDOR=true

# Archivo donde se registra cada ejecucion (fecha, IP, script, resultado)
ARCHIVO_LOG=ejecuciones.log
